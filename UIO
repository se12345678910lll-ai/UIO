local function createToggle(text, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 34)
	btn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 14
	local active = false
	btn.Text = text .. " : OFF"
	btn.Parent = mainFrame

	btn.MouseButton1Click:Connect(function()
		active = not active
		btn.Text = text .. (active and " : ON" or " : OFF")
		btn.BackgroundColor3 = active and Color3.fromRGB(45, 140, 85) or Color3.fromRGB(55, 55, 70)
		callback(active)
	end)
end

local function createAdjustRow(labelText, defaultVal, step, onChange)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(0.9, 0, 0, 32)
	row.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
	row.Parent = mainFrame

	local val = defaultVal
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.55, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.Text = labelText .. ": " .. tostring(val)
	lbl.Parent = row

	local minusBtn = Instance.new("TextButton")
	minusBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
	minusBtn.Position = UDim2.new(0.56, 0, 0.1, 0)
	minusBtn.Text = "-"
	minusBtn.Parent = row

	local plusBtn = Instance.new("TextButton")
	plusBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
	plusBtn.Position = UDim2.new(0.78, 0, 0.1, 0)
	plusBtn.Text = "+"
	plusBtn.Parent = row

	minusBtn.MouseButton1Click:Connect(function()
		val = math.max(step, val - step)
		lbl.Text = labelText .. ": " .. tostring(val)
		onChange(val)
	end)

	plusBtn.MouseButton1Click:Connect(function()
		val = val + step
		lbl.Text = labelText .. ": " .. tostring(val)
		onChange(val)
	end)
end

-- ปุ่มควบคุมทั้ง 6 ฟังก์ชัน
createToggle("บินได้", function(v) setFly(v) end)
createAdjustRow("ความเร็วบิน", UIO_State.FlySpeed, 10, function(v) UIO_State.FlySpeed = v end)

createToggle("วิ่งเร็ว", function(v) setSpeed(v) end)
createAdjustRow("ความเร็ววิ่ง", UIO_State.WalkSpeed, 4, function(v) UIO_State.WalkSpeed = v end)

