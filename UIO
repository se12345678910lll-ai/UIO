-- ==========================================
-- UIO Script Hub (Roblox LocalScript)
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- สถานะฟังก์ชัน (Config / State)
local UIO_State = {
	FlyEnabled = false,
	FlySpeed = 50,

	SpeedEnabled = false,
	WalkSpeed = 32,

	AutoCardTP = false,
	AutoTreadmill = false,
	AutoDoubleX2 = false,
	AutoPlaceCard = false,
}

-- ==========================================
-- Helper Functions สำหรับดึง Character
-- ==========================================
local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function getHumanoid()
	local char = getCharacter()
	return char:FindFirstChildOfClass("Humanoid")
end

local function getRootPart()
	local char = getCharacter()
	return char:FindFirstChild("HumanoidRootPart")
end

-- ==========================================
-- 1. ระบบบินได้ (ปรับความเร็วได้)
-- ==========================================
local bodyVelocity, bodyGyro

local function setFly(enabled)
	UIO_State.FlyEnabled = enabled
	local root = getRootPart()
	local hum = getHumanoid()
	if not root or not hum then return end

	if enabled then
		hum.PlatformStand = true
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = root

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		bodyGyro.P = 1e4
		bodyGyro.CFrame = root.CFrame
		bodyGyro.Parent = root
	else
		hum.PlatformStand = false
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	end
end

RunService.RenderStepped:Connect(function()
	local root = getRootPart()
	if not root then return end

	-- อัปเดตทิศทางการบิน
	if UIO_State.FlyEnabled and bodyVelocity and bodyGyro then
		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit
		end
		bodyVelocity.Velocity = moveDir * UIO_State.FlySpeed
		bodyGyro.CFrame = camera.CFrame
	end

	-- อัปเดตความเร็วการวิ่ง
	local hum = getHumanoid()
	if hum and UIO_State.SpeedEnabled then
		hum.WalkSpeed = UIO_State.WalkSpeed
	end
end)

-- ==========================================
-- 2. ระบบวิ่งเร็ว (ปรับความเร็วได้)
-- ==========================================
local function setSpeed(enabled)
	UIO_State.SpeedEnabled = enabled
	local hum = getHumanoid()
	if not hum then return end

	if enabled then
		hum.WalkSpeed = UIO_State.WalkSpeed
	else
		hum.WalkSpeed = 16 -- ค่ามาตรฐานของ Roblox
	end
end

-- ==========================================
-- 3. วาปไปเก็บการ์ด
-- *ปรับชื่อ Folder / Part การ์ดในแมปให้ตรงกับเกม*
-- ==========================================
local function tpToCardOnce()
	local root = getRootPart()
	if not root then return end

	local cardsFolder = workspace:FindFirstChild("Cards") -- เปลี่ยนชื่อโฟลเดอร์การ์ดตามเกม
	if cardsFolder then
		for _, item in ipairs(cardsFolder:GetChildren()) do
			local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
			if targetPart then
				root.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
				task.wait(0.25)
			end
		end
	end
end

task.spawn(function()
	while true do
		if UIO_State.AutoCardTP then
			tpToCardOnce()
		end
		task.wait(1)
	end
end)

-- ==========================================
-- 4. ฟาร์มลู่วิ่ง (อัตโนมัติ)
-- *ปรับตำแหน่งลู่วิ่ง หรือ RemoteEvent ตามเกม*
-- ==========================================
local treadmillCFrame = CFrame.new(0, 5, 0) -- เปลี่ยนพิกัดลู่วิ่งของเกม

task.spawn(function()
	while true do
		if UIO_State.AutoTreadmill then
			local root = getRootPart()
			local hum = getHumanoid()
			if root and hum then
				-- วาปขึ้นลู่วิ่งหากอยู่ไกลเกินไป
				if (root.Position - treadmillCFrame.Position).Magnitude > 8 then
					root.CFrame = treadmillCFrame
				end
				-- จำลองการเดิน/วิ่งบนลู่วิ่ง
				hum:Move(Vector3.new(0, 0, -1), true)
			end
		end
		task.wait(0.1)
	end
end)

-- ==========================================
-- 5. กดคูณ 2 ในลู่วิ่ง
-- *ปรับชื่อ RemoteEvent หรือปุ่ม UI ให้ตรงกับเกม*
-- ==========================================
task.spawn(function()
	while true do
		if UIO_State.AutoDoubleX2 and UIO_State.AutoTreadmill then
			-- ตัวอย่างเรียกผ่าน RemoteEvent (เปลี่ยนชื่อให้ตรงกับเกม)
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local x2Event = remotes and remotes:FindFirstChild("DoubleX2")
			if x2Event and x2Event:IsA("RemoteEvent") then
				x2Event:FireServer()
			end
		end
		task.wait(0.5)
	end
end)

-- ==========================================
-- 6. วางการ์ด (อัตโนมัติ)
-- *ปรับชื่อ RemoteEvent / ตำแหน่งวางการ์ดให้ตรงกับเกม*
-- ==========================================
local placeCardCFrame = CFrame.new(10, 5, 10) -- เปลี่ยนพิกัดจุดวางการ์ด

task.spawn(function()
	while true do
		if UIO_State.AutoPlaceCard then
			local root = getRootPart()
			if root then
				-- หากต้องเดิน/วาปไปจุดวางการ์ดก่อน
				-- root.CFrame = placeCardCFrame
			end

			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local placeEvent = remotes and remotes:FindFirstChild("PlaceCard")
			if placeEvent and placeEvent:IsA("RemoteEvent") then
				placeEvent:FireServer()
			end
		end
		task.wait(0.5)
	end
end)

